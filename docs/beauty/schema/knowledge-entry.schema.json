{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aesthetic Knowledge Entry",
  "type": "object",
  "required": ["id", "title", "domain", "status", "version", "definition", "claims", "sources", "governance"],
  "properties": {
    "id": {"type":"string","pattern":"^[A-Z]{3}\\.[A-Z0-9_]+\\.[0-9]{3}$"},
    "title": {"type":"string","minLength":2},
    "domain": {"enum":["visual","person","style","design","hair","training","scoring"]},
    "status": {"enum":["draft","sourced","expert_reviewed","calibrated","published","deprecated"]},
    "version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "definition": {"type":"object","required":["summary","includes","excludes"]},
    "observables": {"type":"array"},
    "mechanisms": {"type":"array"},
    "designApplications": {"type":"array"},
    "hairMappings": {"type":"array"},
    "training": {"type":"array"},
    "rubric": {"type":"array"},
    "claims": {"type":"array","minItems":1,"items":{"type":"object","required":["id","text","sourceIds","evidenceGrade","certainty"]}},
    "sources": {"type":"array","minItems":1},
    "governance": {"type":"object","required":["locale","reviewDue","biasAndSafety"]}
  },
  "additionalProperties": true
}
